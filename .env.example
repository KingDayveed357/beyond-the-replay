# Copy to .env for local development. Never commit .env.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional (defaults shown)
# BTR_MODEL=claude-haiku-5-5
# BTR_SERVER_BUDGET_USD=0.20
# BTR_FRESH_RUNS_PER_HOUR=2
# BTR_MAX_CONCURRENT=2

# Optional: send the server key's AI requests to Claude on Microsoft Foundry (docs/AZURE_SETUP.md, Part C)
# BTR_PROVIDER=foundry
# ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource-name
# ANTHROPIC_FOUNDRY_API_KEY=your-foundry-key-here
# BTR_FOUNDRY_DEPLOYMENT=claude-haiku-5-5
